# Copy to .env.local for local dev (never commit .env.local).
# In Netlify: Site settings → Environment variables → scope by context (Production vs Deploy Previews).

# --- Supabase (auth + cloud sync) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Firebase (legacy; remove from Production when Supabase is live) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics); leave empty if unused
VITE_FIREBASE_MEASUREMENT_ID=
